                  },
                  "right": {
                    "op": "literal",
                    "schema": {
                      "type": "text",
                      "required": true,
                      "physical_state": false
                    },
                    "value": "home"
                  }
                },
                {
                  "op": "compare",
                  "comparison": "eq",
                  "left": {
                    "op": "input",
                    "name": "location"
                  },
                  "right": {
                    "op": "literal",
                    "schema": {
                      "type": "text",
                      "required": true,
                      "physical_state": false
                    },
                    "value": "parents"
                  }
                }
              ]
            },
            "then": {
              "op": "literal",
              "schema": {
                "type": "enum",
                "required": true,
                "physical_state": false,
                "value_catalog": [
                  "active",
                  "inactive"
                ]
              },
              "value": "inactive"
            }
          },
          {
            "when": {
              "op": "and",
              "args": [
                {
                  "op": "compare",
                  "comparison": "eq",
                  "left": {
                    "op": "input",
                    "name": "location"
                  },
                  "right": {
                    "op": "literal",
                    "schema": {
                      "type": "text",
                      "required": true,
                      "physical_state": false
                    },
                    "value": "away"
                  }
                },
                {
                  "op": "compare",
                  "comparison": "eq",
                  "left": {
                    "op": "input",
                    "name": "brightness"
                  },
                  "right": {
                    "op": "literal",
                    "schema": {
                      "type": "text",
                      "required": true,
                      "physical_state": false
                    },
                    "value": "dark"
                  }
                },
                {
                  "op": "or",
                  "args": [
                    {
                      "op": "compare",
                      "comparison": "eq",
                      "left": {
                        "op": "input",
                        "name": "phase"
                      },
                      "right": {
                        "op": "literal",
                        "schema": {
                          "type": "text",
                          "required": true,
                          "physical_state": false
                        },
                        "value": "evening"
                      }
                    },
                    {
                      "op": "compare",
                      "comparison": "eq",
                      "left": {
                        "op": "input",
                        "name": "phase"
                      },
                      "right": {
                        "op": "literal",
                        "schema": {
                          "type": "text",
                          "required": true,
                          "physical_state": false
                        },
                        "value": "late_evening"
                      }
                    },
                    {
                      "op": "compare",
                      "comparison": "eq",
                      "left": {
                        "op": "input",
                        "name": "phase"
                      },
                      "right": {
                        "op": "literal",
                        "schema": {
                          "type": "text",
                          "required": true,
                          "physical_state": false
                        },
                        "value": "early_night"
                      }
                    }
                  ]
                }
              ]
            },
            "then": {
              "op": "literal",
              "schema": {
                "type": "enum",
                "required": true,
                "physical_state": false,
                "value_catalog": [
                  "active",
